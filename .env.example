# ============================================
# BASE DE DONNÉES (OBLIGATOIRE)
# ============================================
MONGO_URL=mongodb://localhost:27017/pm_gestion

# ============================================
# SÉCURITÉ (OBLIGATOIRE)
# ============================================
# Générez avec : openssl rand -base64 32
JWT_SECRET=votre-secret-jwt-tres-securise-et-long-min-32-chars
# Dedicated secret for refresh tokens (min 32 chars). REQUIRED in production.
# En dev/test, si absent, dérivé de JWT_SECRET (avec un avertissement).
# openssl rand -base64 48
JWT_REFRESH_SECRET=

# Clé de chiffrement AES-256-GCM pour les secrets stockés en base (SharePoint, etc.)
# OBLIGATOIRE en production. Format hex 64 chars (32 bytes) recommandé.
# Générez avec : openssl rand -hex 32
SECRETS_ENCRYPTION_KEY=

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# SOCKET.IO (Temps réel)
# ============================================
SOCKET_PORT=4000
SOCKET_SERVER_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_SERVER_URL=http://localhost:4000
# Secret partagé entre l'API Next.js et le serveur socket pour /emit
SOCKET_EMIT_SECRET=changez-ce-secret-interne

# ============================================
# CORS
# ============================================
# Comma-separated allowlist of origins permitted to call the API.
# OBLIGATOIRE en production : doit être explicite et ne JAMAIS contenir "localhost".
ALLOWED_ORIGINS=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ============================================
# Rate limiting
# ============================================
# Number of reverse proxies in front of the app that append to X-Forwarded-For.
# Vercel = 1, a single nginx = 1, nginx-behind-CDN = 2. Only used in production.
TRUSTED_PROXY_COUNT=1

# ============================================
# EMAIL (Optionnel - Notifications par email)
# ============================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=votre-email@gmail.com
# SMTP_PASS=votre-mot-de-passe-app
# SMTP_FROM="PM Gestion" <votre-email@gmail.com>
# NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ============================================
# PUSH NOTIFICATIONS (Optionnel - Web Push)
# ============================================
# Générez avec : npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=votre-cle-publique-vapid
# VAPID_PRIVATE_KEY=votre-cle-privee-vapid
# VAPID_SUBJECT=mailto:admin@pm-gestion.com

# ============================================
# SHAREPOINT (Optionnel - Synchronisation fichiers)
# ============================================
# SHAREPOINT_ENABLED=false
# SHAREPOINT_TENANT_ID=votre-tenant-id-azure-ad
# SHAREPOINT_CLIENT_ID=votre-client-id
# SHAREPOINT_CLIENT_SECRET=votre-client-secret
# SHAREPOINT_SITE_ID=votre-site-id

# ============================================
# DOCKER (Optionnel - docker-compose)
# ============================================
# MONGODB_PORT=27017
# MONGO_INITDB_ROOT_USERNAME=admin
# MONGO_INITDB_ROOT_PASSWORD=change_me_in_production
